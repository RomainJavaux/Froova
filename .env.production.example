# Production settings for Hostinger.
# Copy this content into the PRODUCTION_ENV GitHub secret (recommended)
# or into <HOSTINGER_DEPLOY_PATH>/shared/.env on the server.

APP_NAME=Froova
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://ton-domaine.fr
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# hPanel > Bases de données > MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_froova
DB_USERNAME=u000000000_froova
DB_PASSWORD=

# 30 days of activity keeps people signed in; "Rester connecté" covers the rest.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# No queue worker on shared hosting: jobs and e-mails run immediately.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Hostinger e-mail (hPanel > E-mails) — used for invitations and password resets.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=bonjour@ton-domaine.fr
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="bonjour@ton-domaine.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Pages are rendered in the browser (no Node process on shared hosting).
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
